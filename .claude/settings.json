{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-capsule.sh",
            "timeout": 5000,
            "statusMessage": "Session capsule..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/doc-drift-reminder.sh"
          }
        ]
      }
    ]
  }
}
